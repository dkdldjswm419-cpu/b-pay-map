# 로컬 개발용. 이 파일을 복사해 .env 로 만들고 값을 채우세요.
# Vercel 에서는 같은 이름으로 Project Settings → Environment Variables 에 넣습니다.

# Google AI Studio (aistudio.google.com) → Get API key
GEMINI_API_KEY=
# 비워두면 gemini-3.6-flash
GEMINI_MODEL=

# Supabase 대시보드 → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버 전용 (절대 브라우저/깃허브에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
